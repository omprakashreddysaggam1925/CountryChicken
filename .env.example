# Copy this file to .env and replace every placeholder before running locally.
# Never commit .env or real credentials.

# Spring profile and HTTP server
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# PostgreSQL / Docker Compose
POSTGRES_DB=countrychicken
POSTGRES_USER=countrychicken
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_PORT=5432

# Spring datasource
DB_URL=jdbc:postgresql://localhost:5432/countrychicken
DB_USERNAME=countrychicken
DB_PASSWORD=replace-with-a-strong-local-password
DB_POOL_SIZE=10

# JWT
# Must be Base64 and decode to at least 256 bits (32 bytes).
# Generate one with:
#   openssl rand -base64 32
JWT_SECRET=replace-with-a-base64-encoded-32-byte-secret
JWT_ACCESS_TOKEN_TTL=PT15M
JWT_REFRESH_TOKEN_TTL=P30D

# Razorpay (required for payment creation, refunds, and webhook verification)
RAZORPAY_KEY_ID=replace-with-razorpay-key-id
RAZORPAY_KEY_SECRET=replace-with-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-razorpay-webhook-secret
